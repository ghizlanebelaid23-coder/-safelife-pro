# Firebase (client-side — safe to expose in the bundle, protect via Firebase
# security rules instead, not by hiding these values)
REACT_APP_FIREBASE_API_KEY=
REACT_APP_FIREBASE_AUTH_DOMAIN=
REACT_APP_FIREBASE_PROJECT_ID=
REACT_APP_FIREBASE_STORAGE_BUCKET=
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=
REACT_APP_FIREBASE_APP_ID=

# Groq (server-side only — used by api/chat.js, NEVER prefix this with
# REACT_APP_ or it will get bundled into the public JS and leaked).
# Get a free key at https://console.groq.com/keys — it starts with "gsk_".
GROQ_API_KEY=
